# s3seal on the hardened Debian 13 runtime seed of container.gov.de (Secure
# Government Container Initiative): scratch with a trust store and a nonroot
# user, no shell, no package manager. On top only the release and the
# libraries `ldd` proves it needs - glibc, taken from the Debian release the
# seed's own builder pins. The same seed as wx1-keyagent's.
#
#   docker build -f ci/Dockerfile.release --build-arg RELEASE=<name> -t s3seal:<v> out
#
# No shell means no bin/s3seal: nothing is made on a first start. The seed and
# the credentials are the operator's, as files at /run/s3seal, 0600 and owned
# by the user the container runs as (65534) - s3seal refuses either one when
# anybody else can read it.
ARG SEED=registry.opencode.de/oci-community/images/auswaertiges-amt/debian:13.7@sha256:e6a784c10fcb9e6748815e6838b8c71a2f099846131232ddf17581fa518aacc9

# the Debian snapshot the seed's builder uses, so glibc matches the seed's release
FROM debian:trixie-20260918@sha256:9cc080028c43b27d2074d63a5f9caf7166d731494965616c1a6d2827a004585c AS assemble
ARG RELEASE
ADD ${RELEASE}.tar.gz /stage/

RUN set -eu; \
    app=/rootfs/opt/s3seal; \
    mkdir -p /rootfs/opt "$app"; \
    cp -a /stage/${RELEASE}/. "$app/"; \
    # every library ldd proves, from this Debian release - and libgcc_s, which
    # glibc loads itself when a thread ends with pthread_exit
    ldd "$app/sbin/nginx" | awk '/=>/ {print $3} /^\t\// {print $1}' | sort -u > /libs; \
    echo /lib/x86_64-linux-gnu/libgcc_s.so.1 >> /libs; \
    for l in $(cat /libs); do \
      mkdir -p "/rootfs$(dirname "$l")"; cp -L "$l" "/rootfs$l"; \
    done; \
    # and which Debian packages those came from, for the SBOM
    for l in $(cat /libs); do dpkg -S "$(readlink -f "$l")" 2>/dev/null || dpkg -S "$l"; done \
      | cut -d: -f1 | sort -u | xargs dpkg-query -W -f '${Package} ${Version} ${source:Package} ${source:Version}\n' \
      > "$app/BASE-LIBS"; \
    # nginx's working directory: s3seal writes the real configuration into
    # the file nginx was started with, so it has to be writable
    state=/rootfs/var/lib/s3seal; \
    mkdir -p "$state/conf" "$state/logs" /rootfs/run/s3seal; \
    printf '%s\n' \
      '# Written into the image, replaced by s3seal a moment after start.' \
      'daemon off;' 'error_log stderr info;' 'pid logs/meta.pid;' \
      'events { worker_connections 64; }' 'http { }' > "$state/conf/nginx.conf"; \
    chown -R 65534:65534 "$state" /rootfs/run/s3seal; \
    chmod 700 "$state" /rootfs/run/s3seal; \
    find /rootfs -exec touch -h -d @0 {} +

FROM ${SEED}
COPY --from=assemble /rootfs/ /

ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    S3SEAL_SEED=/run/s3seal/seed \
    S3SEAL_CREDENTIALS=/run/s3seal/credentials

LABEL org.opencontainers.image.title="s3seal" \
      org.opencontainers.image.description="An S3 proxy that encrypts, and still tells the truth about it" \
      org.opencontainers.image.source="https://github.com/wx-one/s3seal" \
      org.opencontainers.image.licenses="EUPL-1.2" \
      org.opencontainers.image.base.name="registry.opencode.de/oci-community/images/auswaertiges-amt/debian:13.7"

USER 65534:65534
EXPOSE 9000
ENTRYPOINT ["/opt/s3seal/sbin/nginx", "-c", "/var/lib/s3seal/conf/nginx.conf", "-p", "/var/lib/s3seal"]
